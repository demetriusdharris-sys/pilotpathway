# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role key. SERVER ONLY.
# This key bypasses every Row Level Security policy. It must never be given a
# NEXT_PUBLIC_ prefix, never pasted into a browser, and never committed.
# Without it the tutor route fails closed and refuses to answer, because
# unmetered requests are uncapped requests.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API Keys (used by the AI tutor, added next sprint step)
ANTHROPIC_API_KEY=
